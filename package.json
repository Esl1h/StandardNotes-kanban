{
  "name": "sn-kanban-editor",
  "version": "0.6.2",
  "description": "Kanban board editor for Standard Notes",
  "keywords": [
    "Standard Notes",
    "Standard Notes Extensions",
    "Standard Notes Editors",
    "Kanban Boards",
    "Personal Kanban Board"
  ],
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esl1h/sn-kanban.git"
  },
  "bugs": {
    "url": "https://github.com/Esl1h/sn-kanban/issues"
  },
  "sn": {
    "main": "build/index.html"
  },
  "scripts": {
    "start": "vite --port 3001",
    "build": "vite build",
    "clean-deploy-cache": "rm -rf node_modules/.cache/gh-pages",
    "predeploy": "npm run build && npm run clean-deploy-cache",
    "deploy": "gh-pages -b gh-pages -d build",
    "test": "vitest run",
    "serve": "serve -s -p 3000 build",
    "server-public": "http-server -p 3000 --cors",
    "server-root": "http-server ./ -p 3000 --cors",
    "server": "http-server ./build -p 3000 --cors",
    "pretty": "prettier --write 'src/**/*.{html,css,scss,js,jsx,ts,tsx,json}' README.md",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 3001",
    "lint": "eslint src"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.48.0",
    "filesafe-js": "^1.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-modal": "^3.16.3",
    "react-modal-hook": "^3.0.0",
    "react-trello": "^2.2.11",
    "regenerator-runtime": "^0.14.1",
    "sass": "^1.105.1",
    "sn-editor-kit": "1.0.6",
    "sn-stylekit": "2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^3.1.0",
    "http-server": "^14.1.1",
    "husky": "^4.3.6",
    "jsdom": "^30.1.1",
    "lint-staged": "^10.5.3",
    "prettier": "^2.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "uuid": "^9.0.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "yalc": "^1.0.0-pre.50"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "README.md": [
      "prettier --write"
    ],
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ]
  }
}
