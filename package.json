{
  "name": "standardnotes-kanban",
  "version": "1.4.1",
  "description": "Kanban board editor for Standard Notes",
  "keywords": [
    "Standard Notes",
    "Standard Notes Extensions",
    "Standard Notes Editors",
    "Kanban Boards",
    "Personal Kanban Board"
  ],
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esl1h/StandardNotes-kanban.git"
  },
  "bugs": {
    "url": "https://github.com/Esl1h/StandardNotes-kanban/issues"
  },
  "sn": {
    "main": "build/index.html"
  },
  "scripts": {
    "start": "vite --port 3001",
    "build": "vite build",
    "test": "vitest run",
    "server": "vite preview --port 3000",
    "pretty": "prettier --write 'src/**/*.{html,css,scss,js,jsx,ts,tsx,json}' README.md",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 3001",
    "lint": "eslint src",
    "server-cors": "vite preview --port 3000 --cors",
    "prepare": "husky"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@standardnotes/component-relay": "github:standardnotes/component-relay#164428640ba59e31e7ca3ca932b7d7521594f17c",
    "@standardnotes/stylekit": "^5.29.3",
    "@tabler/icons-react": "^3.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-modal": "^3.16.3",
    "react-modal-hook": "^3.0.0",
    "sass": "^1.105.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^2.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "README.md": [
      "prettier --write"
    ],
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "jsonwebtoken": "^9.0.2"
  }
}
